      "attack_complexity": {
        "rating": "high",
        "authentication": "service",
        "user_interaction": "none",
        "prerequisites": [
          "Shell/CLI access to the Magento server",
          "Running setup:install or setup:config:set command",
          "No web-based setup wizard exists \u2014 CLI only entry point"
        ],
        "rationale": "Rated HIGH because exploitation requires server shell access (to run CLI commands). An attacker with shell access already has direct database access, making this SQL injection largely redundant."
      },
      "environment_relevance": "development",
      "category": "injection",
      "cwe": "CWE-89",
      "status": "confirmed",
      "validation_status": "downgraded",
      "validation_notes": "SQL injection confirmed in source code at lines 145 and 196-197 of DbValidator.php. However, the only entry points are CLI commands (setup:install, setup:config:set) which require server shell access. The web setup wizard has been removed \u2014 setup/index.php only renders a static landing page with no API endpoints. Since an attacker with shell access already has direct database access, this SQLi provides no meaningful privilege escalation. Downgraded from HIGH to LOW.",
      "validated_at": "2026-03-28T04:30:00-04:00",
      "discovered_in_task": "task_002",
      "description": "DbValidator::checkDatabasePrivileges() interpolates $dbName into SQL without parameterization. Line 196-197 allows SQL injection via single quotes in the database name. Line 145 is injectable via backtick escaping. However, this is only reachable via CLI commands (setup:install, setup:config:set) requiring server shell access.",
      "technical_details": "Two injection points exist in setup/src/Magento/Setup/Validator/DbValidator.php:\n\n1. Line 145: %s \u2014 backtick injection\n2. Lines 196-197:  \u2014 single quote injection\n\nThe $dbName parameter flows from:\n- ConfigOptionsList::validateDbSettings() \u2192 checkDatabaseConnectionWithDriverOptions() \u2192 checkDatabaseName()/checkDatabasePrivileges()\n- Entry points: CLI  and  commands only\n- No web API or REST endpoint reaches this code path\n- The old web setup wizard has been removed; setup/index.php only renders a static landing page\n\nSince CLI access implies shell access, which implies direct database access, this SQL injection provides no meaningful additional capability to an attacker.",
      "affected_files": [
        "setup/src/Magento/Setup/Validator/DbValidator.php"
      ],
      "affected_functions": [
        "checkDatabaseName",
        "checkDatabasePrivileges",
        "checkDatabaseConnectionWithDriverOptions"
      ],
      "poc": {
        "type": "description",
        "steps": "bin/magento setup:config:set --db-name=\"test' UNION SELECT table_name FROM information_schema.tables-- \" --db-host=localhost --db-user=root",
        "expected_result": "SQL injection in SCHEMA_PRIVILEGES query against information_schema. The injected SQL would execute in the context of the provided database credentials.",
        "destructive": false,
        "auth_required": "service"
      },
      "impact": {
        "primary": "SQL injection against information_schema database allowing metadata exfiltration, but only exploitable by users who already have server shell access and can directly access the database anyway",
        "additional": [
          "Defense-in-depth violation \u2014 parameterized queries should be used even for CLI-only code paths",
          "If a web-based setup wizard is re-added in the future, this would become a web-exploitable SQLi"
        ],
        "severity_justification": "Downgraded to LOW because the only entry points require server shell access (CLI commands), meaning the attacker already has equivalent or greater database access. The SQL injection is real but provides no privilege escalation."
      },
      "remediation": "Use parameterized queries or connection->quoteIdentifier()/connection->quote() for the database name in both SHOW TABLES FROM and SCHEMA_PRIVILEGES queries.",
      "is_gadget": false,
      "gadget_type": "",
      "chains_with": [],
      "created_at": "2026-03-27T12:25:00-04:00"
